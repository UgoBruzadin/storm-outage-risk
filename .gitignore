# Data: large and rebuilt from public sources (see data/README.md)
data/*
!data/README.md
*.duckdb
*.duckdb.wal
*.parquet
# ...except the dashboard's small precomputed files (~8 MB), so a host can serve the app
!data/app/
!data/app/*.parquet
# ...but not the test year's every-block predictions (~90 MB for the whole country): Hugging Face dataset only
data/app/predictions.parquet
# ...and the live forecast's fixed inputs (live/static.py); its output goes to the live-data branch
!live/static/*.parquet
live/out/

# Environments, caches, tool output
.pixi/*
!.pixi/config.toml
__pycache__/
.ipynb_checkpoints/
mlruns/
mlartifacts/
dbt/target/
dbt/logs/
dbt/dbt_packages/

# Secrets (Hugging Face token etc.) — never commit these
.env

# OS
.DS_Store
dbt/.user.yml
ml/benchmarks/lab.yaml
